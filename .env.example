# KruAI Environment Variables
# Copy this to .env.local for development, or set in Vercel dashboard

# === OpenAI (optional - ถ้าไม่ใส่จะใช้ mock mode) ===
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# === Supabase (optional - ถ้าไม่ใส่จะใช้ localStorage demo mode) ===
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# === App ===
NEXT_PUBLIC_APP_NAME=KruAI
NEXT_PUBLIC_APP_URL=https://kruai.vercel.app
