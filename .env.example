# KruAI Environment Variables
# Copy this to .env.local for development, or set in Vercel dashboard

# === AI Provider (เลือกอันใดอันหนึ่ง) ===

# Option 1: OpenAI (official)
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Option 2: PoYo.ai (OpenAI-compatible proxy) — ถูกกว่า
# OPENAI_API_KEY=poyo-xxx
# OPENAI_API_BASE=https://api.poyo.ai
# OPENAI_MODEL=gpt-5-6-luna

# === Supabase (optional - ถ้าไม่ใส่จะใช้ localStorage demo mode) ===
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxx

# === App ===
NEXT_PUBLIC_APP_NAME=KruAI
NEXT_PUBLIC_APP_URL=https://kruai.vercel.app
